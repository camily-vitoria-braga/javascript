// 21. No switch...case, qual bloco é executado se nenhuma condição for atendida?  
// A) break  
// B) else
//   C) default  
// D) fallback 

let numero = 5;

switch (numero) {
    case 1:
        console.log("break");
        break;
    case 2:
        console.log("else");
        break;
    default:
        console.log("default");
}

